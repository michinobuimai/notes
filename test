// 1. Setup
mapX = floor(rayOrigin.x)
mapY = floor(rayOrigin.y)

stepX = (dx < 0) ? -1 : 1
stepY = (dy < 0) ? -1 : 1

tDeltaX = abs(1.0 / dx)
tDeltaY = abs(1.0 / dy)

// Calculate distance to first cell edges
tMaxX = (stepX > 0 ? (mapX + 1) - rayOrigin.x : rayOrigin.x - mapX) * tDeltaX
tMaxY = (stepY > 0 ? (mapY + 1) - rayOrigin.y : rayOrigin.y - mapY) * tDeltaY

// 2. Loop
while (not out of bounds) {
    if (tMaxX < tMaxY) {
        mapX += stepX
        tMaxX += tDeltaX
    } else {
        mapY += stepY
        tMaxY += tDeltaY
    }
    
    // Visit/Inspect voxel at (mapX, mapY)
}